      "patient_id": "SYN-002",
      "encounter_id": "ENC-002-06",
      "document_type": "medication_reconciliation",
      "title": "Nephrology medication review",
      "author": "Dr. Leila Morgan",
      "event_at": "2026-04-02T10:20:00+03:00",
      "authored_at": "2026-04-02T12:30:00+03:00",
      "mime_type": "application/pdf",
      "text_content": "SYNTHETIC - NOT FOR CLINICAL USE\nClinic list shows losartan 50 mg daily and amlodipine. Patient reports taking 'the old blood pressure pill' until early March but cannot distinguish tablets. No administration record is available.",
      "storage_path": "cases/CASE-002/documents/DOC-002-15.pdf",
      "metadata": {
        "department": "Nephrology",
        "synthetic_label": "SYNTHETIC - NOT FOR CLINICAL USE"
