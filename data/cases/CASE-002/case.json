      "storage_path": "cases/CASE-002/documents/DOC-002-18.pdf",
      "metadata": {
        "department": "Primary Care",
        "synthetic_label": "SYNTHETIC - NOT FOR CLINICAL USE"
      }
    },
    {
      "id": "DOC-002-19",
      "patient_id": "SYN-002",
      "encounter_id": "ENC-002-05",
      "document_type": "patient_instruction",
      "title": "Medication safety instructions",
      "author": "Dr. Hana Tesfaye",
