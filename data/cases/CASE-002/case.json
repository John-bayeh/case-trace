      "authored_at": "2026-04-02T12:00:00+03:00",
      "mime_type": "application/pdf",
      "text_content": "SYNTHETIC - NOT FOR CLINICAL USE\nCreatinine 1.31 mg/dL; eGFR 51 mL/min/1.73 m2; potassium 4.7 mmol/L; sodium 140 mmol/L; BUN 23 mg/dL. Results are final.",
      "storage_path": "cases/CASE-002/documents/DOC-002-16.pdf",
      "metadata": {
        "department": "Nephrology",
        "synthetic_label": "SYNTHETIC - NOT FOR CLINICAL USE"
