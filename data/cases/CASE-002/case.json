  "documents": [
    {
      "id": "DOC-002-01",
      "patient_id": "SYN-002",
      "encounter_id": "ENC-002-01",
      "document_type": "progress_note",
      "title": "Baseline primary care assessment",
      "author": "Dr. Hana Tesfaye",
      "event_at": "2026-01-08T09:40:00+03:00",
      "authored_at": "2026-01-08T12:10:00+03:00",
      "mime_type": "application/pdf",
      "text_content": "SYNTHETIC - NOT FOR CLINICAL USE\n42-year-old with hypertension and prior borderline renal function. Patient reports taking lisinopril 20 mg every morning and amlodipine 5 mg nightly. No recent vomiting or diarrhea. Plan: continue current medicines and obtain metabolic panel.",
      "storage_path": "cases/CASE-002/documents/DOC-002-01.pdf",
      "metadata": {
        "department": "Primary Care",
        "synthetic_label": "SYNTHETIC - NOT FOR CLINICAL USE"
