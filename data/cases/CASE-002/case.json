      "event_at": "2026-02-12T09:45:00+03:00",
      "authored_at": "2026-02-12T09:45:00+03:00",
      "mime_type": "application/pdf",
      "text_content": "SYNTHETIC - NOT FOR CLINICAL USE\nLosartan 50 mg tablet, take one tablet by mouth once daily. Intended start 2026-02-13. Prescription is an order and does not establish dispensing or ingestion.",
      "storage_path": "cases/CASE-002/documents/DOC-002-05.pdf",
      "metadata": {
        "department": "Primary Care",
        "synthetic_label": "SYNTHETIC - NOT FOR CLINICAL USE"
